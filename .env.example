# ==============================================================================
# Lores — Environment Configuration & Secrets Template
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Application Metadata
APP_NAME=Lores
APP_VERSION=0.1.0

# Application Port & Public Service URL
APP_PORT=8156
APP_URL=https://lores.example.com

# Database Connection
# SQLite default (persisted in Docker volume or local directory):
DATABASE_URL=sqlite:///./data/lores.db
# PostgreSQL example:
# DATABASE_URL=postgresql://lores_user:secure_password@db:5432/lores_db

# Security & Authentication Secrets
# Generate a strong 32+ byte random secret (e.g. `openssl rand -hex 32`):
JWT_SECRET=lores-dev-secret-key-change-in-production-32bytes-min
JWT_ALGORITHM=HS256

# Session & Token Lifetimes (in minutes)
# 43200 minutes = 30 days (senior-friendly persistent sessions on trusted devices)
ACCESS_TOKEN_EXPIRE_MINUTES=43200
OTP_EXPIRE_MINUTES=15

# CORS Origins & Allowed Hosts (Comma-separated)
# Add your production domain(s) here:
CORS_ORIGINS=http://localhost:8156,http://localhost:3000,http://localhost:5173,https://lores.example.com
ALLOWED_HOSTS=lores.example.com,localhost

# Transactional Email / SMTP Provider (e.g. Resend, Brevo, AWS SES, SendGrid, Gmail)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_smtp_api_key_or_password_here
EMAILS_FROM_EMAIL=lores@yourdomain.com
EMAILS_FROM_NAME="Lores Family Tree"
SMTP_TLS=true
