# ==============================================================================
# Lores — Environment Configuration & Secrets Template
# Copy this file to .env and adjust variables for your environment.
# ==============================================================================

# Application Metadata
APP_NAME=Lores
APP_VERSION=0.1.0

# Host Port Configuration (Docker Compose & Local Binding)
# Change these if port 8000 or 3000 are already in use on your host machine:
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database Connection
# Local SQLite default (persisted in Docker volume or local directory):
DATABASE_URL=sqlite:///./data/lores.db
# PostgreSQL example:
# DATABASE_URL=postgresql://lores_user:secure_password@db:5432/lores_db

# Security & Authentication Secrets
# Generate a strong 32+ byte random secret (e.g. `openssl rand -hex 32`):
JWT_SECRET=change-this-to-a-secure-random-32-byte-secret-in-production
JWT_ALGORITHM=HS256

# Session & Token Lifetimes (in minutes)
# 43200 minutes = 30 days (senior-friendly persistent sessions on trusted devices)
ACCESS_TOKEN_EXPIRE_MINUTES=43200
OTP_EXPIRE_MINUTES=15

# CORS Origins (comma-separated allowed origins in production)
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# Optional: Transactional Email / SMTP Provider for outbound OTPs and Invites
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# EMAIL_FROM=noreply@lores.family.org
